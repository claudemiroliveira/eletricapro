
<style>
    :root{
      --bg:#08111f;
      --bg2:#111a30;
      --card:#17223cbb;
      --card-border:#243459;
      --card-hover:#20345fb3;
      --text:#eef4ff;
      --muted:#9fb0d3;
      --accent:#4dc8ff;
      --accent-2:#70a5ff;
      --accent-3:#e6b64b;
      --success:#41d687;
      --warning:#f7c96c;
      --danger:#ff7e8d;
      --shadow:0 14px 34px rgba(0,0,0,.35);
      --radius:18px;
      --radius-sm:14px;
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      font-family:Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      color:var(--text);
      background:
        radial-gradient(circle at top left, rgba(82,126,255,.16), transparent 26%),
        radial-gradient(circle at 85% 30%, rgba(77,200,255,.08), transparent 18%),
        linear-gradient(180deg, #0a1324 0%, #0c1220 45%, #08111f 100%);
      min-height:100vh;
      overflow-x:hidden;
    }
    body::before{
      content:"";
      position:fixed; inset:0;
      pointer-events:none;
      background-image:radial-gradient(rgba(255,255,255,.06) 1px, transparent 1px);
      background-size:28px 28px;
      opacity:.08;
      mask-image:linear-gradient(180deg, rgba(0,0,0,.7), transparent 95%);
    }
    .app{
      width:min(1160px, calc(100% - 28px));
      margin:0 auto;
      padding:24px 0 96px;
    }
    .hero{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:18px;
      margin-bottom:22px;
      flex-wrap:wrap;
    }
    .title-wrap{display:flex; gap:14px; align-items:flex-start}
    .title-accent{
      width:4px; min-height:56px; border-radius:999px;
      background:linear-gradient(180deg, #ffdb7a, #c89615);
      box-shadow:0 0 18px rgba(247,201,108,.35);
      margin-top:3px;
    }
    h1{margin:0; font-size:clamp(1.55rem, 2vw, 2.35rem); letter-spacing:.01em}
    .subtitle{margin:8px 0 0; color:var(--muted); max-width:720px; line-height:1.55}
    .hero-actions{display:flex; gap:12px; flex-wrap:wrap}
    .btn{
      border:1px solid #2c436f;
      background:linear-gradient(180deg, rgba(29,44,73,.95), rgba(18,28,49,.95));
      color:var(--text);
      border-radius:14px;
      padding:12px 16px;
      cursor:pointer;
      box-shadow:var(--shadow);
      font-weight:700;
      transition:.2s transform, .2s box-shadow, .2s border-color;
    }
    .btn:hover{transform:translateY(-1px); border-color:#4dc8ff66; box-shadow:0 14px 34px rgba(11, 32, 72,.46)}
    .btn.primary{background:linear-gradient(180deg, #22bdf7, #1f74ff); border-color:#55cfff; color:#08111f}
    .toolbar{
      display:grid;
      grid-template-columns:1.2fr .8fr;
      gap:16px;
      margin-bottom:18px;
    }
    .search,.notice{
      background:linear-gradient(180deg, rgba(20,29,49,.92), rgba(14,20,38,.88));
      border:1px solid #243459;
      border-radius:16px;
      padding:14px 16px;
      box-shadow:var(--shadow);
      backdrop-filter:blur(12px);
    }
    .search input{
      width:100%; background:transparent; color:var(--text); border:none; outline:none;
      font-size:1rem;
    }
    .notice{display:flex; align-items:center; justify-content:space-between; gap:12px; color:var(--muted)}
    .grid{
      display:grid;
      grid-template-columns:repeat(2, minmax(0,1fr));
      gap:16px;
    }
    .card{
      position:relative;
      display:flex;
      align-items:center;
      gap:14px;
      width:100%;
      min-height:96px;
      padding:18px;
      border-radius:18px;
      border:1px solid var(--card-border);
      background:
        linear-gradient(180deg, rgba(30,45,77,.9), rgba(20,30,54,.82)),
        linear-gradient(135deg, rgba(84,116,255,.18), transparent 40%);
      box-shadow:var(--shadow);
      cursor:pointer;
      transition:transform .22s ease, border-color .22s ease, box-shadow .22s ease, background .22s ease;
      overflow:hidden;
      text-align:left;
      color:inherit;
    }
    .card::after{
      content:"";
      position:absolute;
      inset:auto -20% -40% auto;
      width:220px; height:140px;
      background:radial-gradient(circle, rgba(77,200,255,.15), transparent 70%);
      opacity:.85;
      pointer-events:none;
    }
    .card:hover, .card.active{
      transform:translateY(-2px);
      border-color:#49c9ff;
      box-shadow:0 0 0 1px rgba(73,201,255,.22), 0 10px 30px rgba(0,0,0,.42), 0 0 24px rgba(73,201,255,.18);
      background:linear-gradient(180deg, rgba(35,56,94,.96), rgba(22,34,61,.92));
    }
    .icon-box{
      width:54px; height:54px; border-radius:16px;
      display:grid; place-items:center;
      flex:0 0 auto;
      background:linear-gradient(180deg, rgba(85,161,255,.26), rgba(77,200,255,.12));
      border:1px solid rgba(112,165,255,.28);
      box-shadow:inset 0 1px 0 rgba(255,255,255,.08), 0 10px 20px rgba(2,10,24,.3);
    }
    .icon-box svg{width:26px; height:26px}
    .card h3{margin:0 0 6px; font-size:1.08rem}
    .card p{margin:0; color:var(--muted); font-size:.94rem}
    .pill{
      margin-left:auto;
      padding:8px 10px;
      border-radius:999px;
      font-size:.75rem;
      color:#c7d8ff;
      background:rgba(112,165,255,.12);
      border:1px solid rgba(112,165,255,.22);
      white-space:nowrap;
    }

    .modal{
      position:fixed; inset:0;
      display:none; align-items:flex-end; justify-content:center;
      background:rgba(4,9,18,.58);
      backdrop-filter:blur(10px);
      padding:18px;
      z-index:30;
    }
    .modal.open{display:flex}
    .sheet{
      width:min(900px, 100%);
      max-height:min(86vh, 980px);
      overflow:auto;
      border-radius:24px;
      border:1px solid #263b64;
      background:linear-gradient(180deg, rgba(12,20,37,.98), rgba(10,17,31,.98));
      box-shadow:0 20px 60px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.04);
      padding:20px;
    }
    .sheet-header{
      display:flex; justify-content:space-between; gap:14px; align-items:flex-start; margin-bottom:16px;
      position:sticky; top:-20px; z-index:5; padding:6px 0 14px;
      background:linear-gradient(180deg, rgba(12,20,37,.98), rgba(12,20,37,.94) 76%, rgba(12,20,37,0));
      backdrop-filter:blur(10px);
    }
    .sheet-title h2{margin:0 0 6px; font-size:1.4rem}
    .sheet-title p{margin:0; color:var(--muted); line-height:1.5}
    .close{
      border:none; width:42px; height:42px; border-radius:12px; cursor:pointer;
      background:#16233f; color:var(--text); font-size:1.1rem;
    }
    .calc-layout{
      display:grid;
      grid-template-columns:1.05fr .95fr;
      gap:18px;
      align-items:start;
    }
    .panel{
      border:1px solid #23375e; border-radius:18px; padding:16px;
      background:linear-gradient(180deg, rgba(21,31,56,.88), rgba(14,21,40,.78));
      box-shadow:var(--shadow);
    }
    .panel h3{margin:0 0 14px; font-size:1rem}
    .field-grid{display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:12px}
    .field{display:flex; flex-direction:column; gap:8px}
    .field label{font-size:.88rem; color:#d9e6ff}
    .field input, .field select{
      width:100%;
      border:1px solid #29416e;
      background:#0d1830;
      color:var(--text);
      padding:13px 12px;
      border-radius:12px;
      outline:none;
      box-shadow:inset 0 1px 0 rgba(255,255,255,.03);
    }
    .field small{color:var(--muted)}
    .field.full{grid-column:1/-1}
    .actions{display:flex; gap:12px; flex-wrap:wrap; margin-top:14px}
    .result{
      display:grid; gap:12px;
    }
    .stat{
      border:1px solid #28436f; border-radius:16px; padding:14px;
      background:linear-gradient(180deg, rgba(18,28,49,.92), rgba(12,20,36,.92));
    }
    .stat .k{display:block; font-size:.82rem; color:var(--muted); margin-bottom:6px}
    .stat .v{font-size:1.15rem; font-weight:800}
    .formula, .warn{
      padding:13px 14px; border-radius:14px; line-height:1.55; color:#d5e1fb;
      background:rgba(112,165,255,.08); border:1px solid rgba(112,165,255,.18)
    }
    .warn{background:rgba(230,182,75,.09); border-color:rgba(230,182,75,.2); color:#ffe7ad}
    .footer-note{margin-top:18px; color:var(--muted); font-size:.9rem; line-height:1.6}
    .hidden{display:none !important}
    .mini{font-size:.84rem; color:var(--muted)}
    .toast{
      position:fixed; left:50%; bottom:18px; transform:translateX(-50%) translateY(22px);
      opacity:0; pointer-events:none; transition:.25s ease;
      padding:12px 14px; border-radius:12px; color:#07111f;
      background:linear-gradient(180deg, #8be6ff, #4dc8ff); font-weight:800; z-index:50;
      box-shadow:0 16px 36px rgba(0,0,0,.32);
    }
    .toast.show{opacity:1; transform:translateX(-50%) translateY(0)}
    @media (max-width: 900px){
      .toolbar, .calc-layout, .grid{grid-template-columns:1fr}
      .pill{display:none}
    }
    @media (max-width: 640px){
      .app{width:min(100% - 18px, 100%); padding-top:16px}
      .card{min-height:88px; padding:16px}
      .field-grid{grid-template-columns:1fr}
      .sheet{padding:16px; border-radius:20px}
    }
  </style>
</head>
<body>
  <div class="app">
    <section class="hero">
      <div class="title-wrap">
        <div class="title-accent"></div>
        <div>
